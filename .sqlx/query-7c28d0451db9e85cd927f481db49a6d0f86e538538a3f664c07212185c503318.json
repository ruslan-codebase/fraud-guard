{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                transaction_id,\n                source_account,\n                destination_account,\n                amount,\n                currency,\n                timestamp\n            FROM transactions\n            WHERE source_account = $1\n              AND timestamp >= $2\n              AND timestamp < $3\n            ORDER BY timestamp ASC\n            ",
