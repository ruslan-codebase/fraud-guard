{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                code,\n                rule_type,\n                params,\n                enabled,\n                priority,\n                valid_from,\n                valid_until\n            FROM rules\n            WHERE enabled = true\n              AND valid_from <= NOW()\n              AND (valid_until IS NULL OR valid_until > NOW())\n            ORDER BY priority DESC\n            ",
